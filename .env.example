# Server-only settings. Copy to .env.local and configure the features you need.
NEON_DATABASE_URL=
USDA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# The original FastAPI ResNet service, e.g. http://127.0.0.1:8080
EQUIPMENT_API_URL=
# Text-to-speech assistant replies and voice-to-text prompts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Gmail address + app password used to email AI plan drafts
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Uploads equipment-classifier feedback to Cloudflare R2 instead of local-only download
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Authentication: generate once with `npx auth secret`; keep stable across deploys.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
# Production account email delivery (verified Resend sender required).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
SUPPORT_EMAIL=
SECURITY_CONTACT_EMAIL=
# OAuth callbacks: /api/auth/callback/google and /api/auth/callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=
# Bot protection: set the public site key and server secret together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared Redis throttling; durable Postgres throttling is used otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Scheduled export retry/expiry and final account deletion. Vercel injects this.
CRON_SECRET=
# Optional monitoring and consent-gated analytics.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

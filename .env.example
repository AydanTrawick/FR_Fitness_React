# Server-only settings. Copy to .env.local and configure the features you need.
NEON_DATABASE_URL=
USDA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Progress Coach uses the same server-side Anthropic key; model IDs stay configurable.
COACH_MODEL=claude-sonnet-5-5
# The original FastAPI ResNet service, e.g. http://127.0.0.1:8080
EQUIPMENT_API_URL=
# Text-to-speech assistant replies and voice-to-text prompts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Gmail address + app password used to email AI plan drafts
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Uploads equipment-classifier feedback to Cloudflare R2 instead of local-only download
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Separate, private bucket for progress photos. Disable r2.dev and all custom domains.
PROGRESS_R2_BUCKET_NAME=
# Cloudflare account API token with R2 read access, used to verify bucket privacy.
# This is separate from the S3-compatible access key/secret above.
PROGRESS_R2_API_TOKEN=

# Authentication: generate once with `npx auth secret`; keep stable across deploys.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional additional exact HTTPS app origins, comma separated (no wildcards).
AUTH_TRUSTED_ORIGINS=
# Preferred account email delivery (verified Resend sender required).
# Gmail fallback is development-only; production account emails require Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
SUPPORT_EMAIL=
SECURITY_CONTACT_EMAIL=
# OAuth callbacks: /api/auth/callback/google and /api/auth/callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=
# Bot protection: set the public site key and server secret together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Shared sliding-window limits for auth, AI plans and voice.
# Missing/unreachable Redis fails open with a server warning for these routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Scheduled export retry/expiry and final account deletion. Vercel injects this.
CRON_SECRET=
# Optional monitoring and consent-gated analytics.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

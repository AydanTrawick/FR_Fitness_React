{
  "name": "frtk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:exercises": "node --env-file=.env scripts/migrate-exercises.mjs",
    "db:seed-free-exercises": "node --env-file=.env scripts/seed-free-exercises.mjs",
    "db:muscle-heatmap": "node --env-file=.env scripts/migrate-muscle-heatmap.mjs",
    "db:unmatched-exercises": "node --env-file=.env scripts/report-unmatched-exercises.mjs",
    "db:verify-muscle-heatmap": "node --env-file=.env --experimental-strip-types scripts/verify-muscle-heatmap.mjs",
    "catalog:build": "node scripts/build-exercise-catalog.mjs",
    "test:library": "node --env-file=.env tests/library.integration.mjs",
    "test:browser": "node --env-file=.env node_modules/@playwright/test/cli.js test tests/browser.spec.mjs --workers=1",
    "db:auth": "node --env-file=.env --env-file=.env.local scripts/migrate-auth.mjs",
    "test:auth": "node --env-file=.env --env-file=.env.local node_modules/@playwright/test/cli.js test tests/auth.browser.spec.mjs --workers=1 tests/auth-recovery.browser.spec.mjs",
    "dev:auth-tests": "node scripts/auth-test-server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@better-auth/passkey": "^1.7.7",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@plexapro/react-body-highlighter": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^11.4.0",
    "@upstash/redis": "^1.39.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "posthog-js": "^1.435.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}

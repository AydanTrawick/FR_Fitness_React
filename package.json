{
  "name": "frtk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:exercises": "node --env-file=.env scripts/migrate-exercises.mjs",
    "db:seed-free-exercises": "node --env-file=.env scripts/seed-free-exercises.mjs",
    "db:muscle-heatmap": "node --env-file=.env scripts/migrate-muscle-heatmap.mjs",
    "db:unmatched-exercises": "node --env-file=.env scripts/report-unmatched-exercises.mjs",
    "db:verify-muscle-heatmap": "node --env-file=.env --experimental-strip-types scripts/verify-muscle-heatmap.mjs",
    "catalog:build": "node scripts/build-exercise-catalog.mjs",
    "test:library": "node --env-file=.env tests/library.integration.mjs",
    "test:browser": "node --env-file=.env node_modules/@playwright/test/cli.js test tests/browser.spec.mjs --workers=1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@plexapro/react-body-highlighter": "^1.0.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
